{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "architect": {
      "tools": {
        "XcodeBuildMCP*": false,
        "xcode_tools_*": false
      },
      "permission": {
        "task": {
          "*": "allow"
        },
        "bash": {
          "*": "allow",
          "xcodebuild*": "deny",
          "*xcodebuild *": "deny",
          "*xcrun *": "deny",
          "xcrun xcresulttool get test-results*": "allow",
          "xcrun xcresulttool get build-results*": "allow",
          "xcrun xcresulttool get log*": "allow",
          "xcrun xcresulttool get content-availability*": "allow"
        }
      }
    }
  },
  "mcp": {
    "sosumi": {
      "type": "remote",
      "url": "https://sosumi.ai/mcp",
      "enabled": true
    },
    "xcode": {
      "command": [
        "xcrun",
        "mcpbridge"
      ],
      "enabled": true,
      "timeout": 600000,
      "type": "local"
    },
    "XcodeBuildMCP": {
      "command": [
        "/bin/sh",
        "-c",
        "XCODEBUILDMCP_CWD=\"$(git rev-parse --show-toplevel)\" && export XCODEBUILDMCP_CWD && cd \"$XCODEBUILDMCP_CWD\" && exec /opt/homebrew/bin/xcodebuildmcp mcp"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 600000,
      "type": "local"
    },
    "paper": {
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp",
      "enabled": true
    }
  }
}
